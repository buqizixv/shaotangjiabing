diff --git a/crates/shell/src/onway_background.rs b/crates/shell/src/onway_background.rs
new file mode 100644
--- /dev/null
+++ b/crates/shell/src/onway_background.rs
@@ -0,0 +1,155 @@
+//! Optional local Onway companion. Enabled only by the local launcher, gated by
+//! the admitted app's policy. The shell owns its lifetime; no window owns trips.
+use makepad_widgets::*;
+use serde_json::{json, Value};
+use std::path::PathBuf;
+use std::process::{Child, Command, Stdio};
+use std::sync::{Mutex, OnceLock};
+
+#[derive(Default)]
+struct Supervisor {
+    child: Option<Child>,
+    last_spawn: u64,
+    published: bool,
+    last_publish: u64,
+    gps_timestamp: f64,
+    opened_request: String,
+    hidden_trip: String,
+}
+
+static WORKER: OnceLock<Mutex<Supervisor>> = OnceLock::new();
+
+#[cfg(any(feature = "app-hub", native_mobile))]
+static ASSETS: OnceLock<Mutex<Option<octosense_app_policy::AssetServer>>> = OnceLock::new();
+
+/// Bundle artwork gets the same narrow loopback exception as the Card runner.
+#[cfg(any(feature = "app-hub", native_mobile))]
+pub fn asset_origin(root: &std::path::Path) -> Option<(String, String)> {
+    let mut assets = ASSETS.get_or_init(|| Mutex::new(None)).lock().ok()?;
+    if assets.is_none() {
+        *assets = octosense_app_policy::AssetServer::start_with_static(&root.join("onway/bundle"), &[]).ok();
+    }
+    assets.as_ref().map(|server| (server.origin().to_string(), server.allowlist_entry()))
+}
+
+fn read(path: PathBuf) -> Value {
+    std::fs::read(path).ok().and_then(|bytes| serde_json::from_slice(&bytes).ok()).unwrap_or(Value::Null)
+}
+
+fn seconds() -> u64 {
+    std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0)
+}
+
+/// Return whether the current card should be opened at the right of the desk.
+#[cfg(any(feature = "app-hub", native_mobile))]
+pub fn poll(cx: &Cx) -> bool {
+    let Some(app_dir) = std::env::var_os("ONWAY_APP_DIR").map(PathBuf::from) else { return false };
+    let root = octosense_app_hub_app::data_root(cx);
+    let Ok(policy) = crate::glance_card::app_isolate(cx, "onway") else { return false };
+    if !policy.capabilities.iter().any(|c| c == "glance") { return false; }
+    let mut worker = WORKER.get_or_init(|| Mutex::new(Supervisor::default())).lock().unwrap();
+    let now = seconds();
+    if worker.child.as_mut().is_some_and(|c| c.try_wait().ok().flatten().is_some()) {
+        worker.child = None;
+    }
+    if worker.child.is_none() && now.saturating_sub(worker.last_spawn) > 30 {
+        worker.last_spawn = now;
+        let python = std::env::var_os("ONWAY_PYTHON").unwrap_or_else(|| "python".into());
+        let mut cmd = Command::new(python);
+        cmd.args(["-X", "utf8", "-m", "backend.v060.worker", "--data-root"])
+            .arg(&root).arg("--parent-pid").arg(std::process::id().to_string())
+            .current_dir(&app_dir).stdin(Stdio::null()).stdout(Stdio::null()).stderr(Stdio::null());
+        #[cfg(target_os = "windows")]
+        {
+            use std::os::windows::process::CommandExt;
+            cmd.creation_flags(0x08000000); // CREATE_NO_WINDOW
+        }
+        match cmd.spawn() {
+            Ok(child) => { worker.child = Some(child); log!("onway: local companion started"); }
+            Err(_) => log!("onway: could not start the local companion; check the launcher runtime"),
+        }
+    }
+    let data = root.join("onway");
+    let cfg = read(data.join("cfg-v060.json"));
+    if cfg["tracking"].as_bool() == Some(true) && policy.capabilities.iter().any(|c| c == "location") {
+        makepad_platform::gps::request_location();
+        let fix = makepad_platform::gps::last_gps_fix();
+        let timestamp = fix.map(|p| p.timestamp).unwrap_or(0.0);
+        let mut position = json!({"system":"wgs84", "status":makepad_platform::gps::location_status(), "timestamp": timestamp});
+        if let Some(p) = fix {
+            position["lat"] = json!(p.lat);
+            position["lon"] = json!(p.lon);
+            position["accuracy"] = json!(p.acc);
+        }
+        // Preserve the SOURCE timestamp. Polling a cached fix does not make it new.
+        let tmp = data.join("device-location.tmp");
+        if std::fs::write(&tmp, position.to_string()).is_ok() {
+            let _ = std::fs::rename(&tmp, data.join("device-location.json"));
+        }
+        worker.gps_timestamp = timestamp;
+    } else {
+        let _ = std::fs::remove_file(data.join("device-location.json"));
+    }
+    let state = read(data.join("view-state.json"));
+    let visible = state["cardVisible"].as_bool() == Some(true);
+    if visible && (!worker.published || now.saturating_sub(worker.last_publish) >= 3600) {
+        if let Ok(script) = std::fs::read_to_string(app_dir.join("card-v060.splash")) {
+            let Some((origin, _)) = asset_origin(&root) else { return false };
+            let script = script.replace("{{assets}}", &origin);
+            let args = json!({"card_id":"current-trip", "title":"在途 · 当前行程", "script":script,
+                "priority":60, "expires":7200, "notify":false, "open":{"app":"onway"}});
+            let caller = crate::glance::Caller::Contained { app:"onway".into(), granted:true };
+            if crate::glance::request(&caller, "glance.publish", &args).is_ok() {
+                worker.published = true;
+                worker.last_publish = now;
+            }
+        }
+    } else if !visible && worker.published {
+        let _ = crate::glance::request(&crate::glance::Caller::granted("onway"), "glance.withdraw", &json!({"card_id":"current-trip"}));
+        worker.published = false;
+    }
+    visible && worker.published
+}
+
+#[cfg(not(any(feature = "app-hub", native_mobile)))]
+pub fn poll(_cx: &Cx) -> bool { false }
+
+#[cfg(any(feature = "app-hub", native_mobile))]
+pub fn open_main_requested(cx: &Cx) -> bool {
+    if std::env::var_os("ONWAY_APP_DIR").is_none() { return false; }
+    let nav = read(octosense_app_hub_app::data_root(cx).join("onway/view-state.json"))["navigation"].clone();
+    let Some(id) = nav["id"].as_str() else { return false; };
+    if nav["expires"].as_f64().unwrap_or(0.0) <= seconds() as f64 { return false; }
+    let mut worker = WORKER.get_or_init(|| Mutex::new(Supervisor::default())).lock().unwrap();
+    if worker.opened_request == id { return false; }
+    worker.opened_request = id.into();
+    true
+}
+
+#[cfg(not(any(feature = "app-hub", native_mobile)))]
+pub fn open_main_requested(_cx: &Cx) -> bool { false }
+
+pub fn shutdown() {
+    if let Some(worker) = WORKER.get() {
+        if let Ok(mut worker) = worker.lock() {
+            if let Some(mut child) = worker.child.take() {
+                let _ = child.kill();
+                let _ = child.wait();
+            }
+        }
+    }
+}
+
+#[cfg(any(feature = "app-hub", native_mobile))]
+pub fn hide_main_requested(cx: &Cx) -> bool {
+    if std::env::var_os("ONWAY_APP_DIR").is_none() { return false; }
+    let state = read(octosense_app_hub_app::data_root(cx).join("onway/view-state.json"));
+    let Some(id) = state["trip"]["id"].as_str() else { return false; };
+    let mut worker = WORKER.get_or_init(|| Mutex::new(Supervisor::default())).lock().unwrap();
+    if !worker.published || worker.hidden_trip == id { return false; }
+    worker.hidden_trip = id.into();
+    true
+}
+
+#[cfg(not(any(feature = "app-hub", native_mobile)))]
+pub fn hide_main_requested(_cx: &Cx) -> bool { false }
