 //! destroys groups, split ratios, workspace membership, or an app instance.
 use crate::layout::{ClientId, LRect};
 
+/// A person's preferred opening size; subsequent resize gestures stay free.
+/// Width and aspect apply to the whole outer frame, including its title bar.
+pub fn preferred_open_rect(app: &str, area: LRect) -> Option<LRect> {
+    if app == "hub:onway" && std::env::var_os("ONWAY_APP_DIR").is_some() {
+        let width = 480.0_f64.min((area.w - 48.0) * 0.48).min((area.h - 48.0) / 2.0_f64.sqrt());
+        return Some(LRect { x: area.x + 24.0, y: area.y + (area.h - width * 2.0_f64.sqrt()) * 0.5,
+            w: width, h: width * 2.0_f64.sqrt() });
+    }
+    let path = crate::octosense::paths::home().join("wm/window-sizes.json");
+    let settings: serde_json::Value = serde_json::from_slice(&std::fs::read(path).ok()?).ok()?;
+    let entry = settings.get(app)?;
+    opening_rect(entry.get("width")?.as_f64()?, entry.get("aspect")?.as_f64()?, area)
+}
+
+fn opening_rect(width: f64, aspect: f64, area: LRect) -> Option<LRect> {
+    if !width.is_finite() || !aspect.is_finite() || width < 80.0 || aspect <= 0.0 {
+        return None;
+    }
+    let width = width.min(area.w * 0.9).min(area.h * 0.9 * aspect);
+    Some(area.centered(width, width / aspect))
+}
+
