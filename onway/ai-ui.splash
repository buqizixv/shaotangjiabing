// Advice stays inside the current commute card.
if aiEnabled && aiCard != nil && aiCard.expires > time_now() && aiCard.stage == screen {
    View{width: Fill height: 160 flow: Down padding: Inset{left: 28 right: 28 top: 10 bottom: 10}
        RoundedView{width: Fill height: Fill flow: Down padding: 14 spacing: 6 draw_bg.color: #x2997ff18 draw_bg.border_radius: 10
            Label{width: Fill text: aiCard.title draw_text.color: #x2997ff draw_text.text_style: OnwayAI{font_size: 12}}
            OnwayScroll{width: Fill height: Fill flow: Down spacing: 6
                Label{width: Fill height: Fit text: aiCard.body draw_text.color: if screen == "idle" || screen == "canceled" || screen == "arrived" {#x1d1d1f} else {#xffffff} draw_text.text_style: OnwayAI{font_size: 11}}
                Label{width: Fill height: Fit text: aiCard.reason draw_text.color: if screen == "idle" || screen == "canceled" || screen == "arrived" {#x666666} else {#xaaaaaa} draw_text.text_style: OnwayAI{font_size: 9}}
            }
            MenuButton{height: 26 text: "收起建议" draw_text.text_style: OnwayAI{font_size: 9} on_click: || dismissAI()}
        }
    }
}
