[Unit]
Description=Onway API key gateway
After=network-online.target
Wants=network-online.target

[Service]
User=onway-gateway
Group=onway-gateway
WorkingDirectory=/opt/onway-gateway
EnvironmentFile=/etc/onway-gateway/secrets.env
ExecStart=/usr/bin/python3 -u /opt/onway-gateway/gateway/server.py --port 8080
Restart=on-failure
RestartSec=3
StateDirectory=onway-gateway
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/onway-gateway

[Install]
WantedBy=multi-user.target
