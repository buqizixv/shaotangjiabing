let Regular = TextStyle{font_family: FontFamily{latin := FontMember{res: http_resource("{{assets}}/assets/NotoSansSC-AI-Regular.otf") asc: -0.2 desc: 0.08 weight: 400}} font_size: 12.75 line_spacing: 1.0}
let Bold = Regular{font_family: FontFamily{latin := FontMember{res: http_resource("{{assets}}/assets/NotoSansSC-Onway-Bold.otf") asc: -0.2 desc: 0.08 weight: 700} fallback := FontMember{res: http_resource("{{assets}}/assets/NotoSansSC-AI-Regular.otf") asc: -0.2 desc: 0.08 weight: 400}}}
// Published once through glance; this live card reads the same private state as P1-P3.
let state=nil
let correction=false
let snooze=false
let serial=0
let instance="card-"+random_u32()
fn send(action,payload){
    serial=serial+1
    let id=instance+"-"+round(time_now()*1000)+"-"+serial
    let tripId=nil
    if state != nil && state.trip != nil {tripId=state.trip.id}
    fs.mkdir("commands")
    fs.write("commands/cmd-"+id+".json",{id: id action: action payload: payload tripId: tripId}.to_json())
    correction=false;snooze=false;ui.card.render()
}
fn poll(){
    if fs.exists("view-state.json") == false {return}
    let fresh=fs.read("view-state.json").parse_json()
    if fresh == nil || fresh.schema != 6 {return}
    let changed=state == nil || fresh.revision != state.revision
    state=fresh
    if state.card.visual.busVisible {fs.write("bus-view.json",{epoch:time_now()}.to_json())}
    if changed {ui.card.render()}
}
start_timeout(0.1,|| poll())
start_interval(2.0,|| poll())
let BodyText=Label{padding: 0 width: Fill height: Fit draw_text.color: #x1d1d1f draw_text.text_style: Regular draw_text.wrap: TextWrap.Word}
let Caption=BodyText{draw_text.color: #x666666 draw_text.text_style.font_size: 9.75}
let Title=BodyText{draw_text.text_style: Bold{font_size: 27}}
let Fact=BodyText{draw_text.text_style: Bold{font_size: 18}}
let Action=ButtonFlat{width: Fill height: 48 padding: 10 draw_bg +: {color: #x0066cc color_hover: #x0071e3 color_down: #x0055aa border_radius: 24 border_size: 0} draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff text_style: Regular}}
let Secondary=Action{draw_bg +: {color: #xf5f5f7 color_hover: #xe8e8ed color_down: #xdedee5 border_radius: 9} draw_text +: {color: #x0066cc color_hover: #x0066cc color_down: #x0066cc}}
let Flat=ButtonFlat{width: Fit height: 44 padding: 0 draw_bg +: {color: #x00000000 color_hover: #x00000000 color_down: #x00000000 border_size: 0} draw_text +: {color: #x0066cc color_hover: #x0066cc color_down: #x0066cc text_style: Regular}}
let Icon=Svg{width: 20 height: 20 animating: false draw_svg.preserve_viewbox: true draw_svg.preserve_aspect: true}
SolidView{width: Fill height: Fill flow: Down draw_bg.color: #xffffff
card:=View{width: Fill height: Fill flow: Down on_render: || {
if state == nil {Caption{text: "连接行程状态…"}} else {
    let c=state.card
    let v=c.visual
    let walking=c.stage == "walking" || c.stage == "transfer" || c.stage == "lastwalk"
    let dark=c.kind == "C2" || c.kind == "C3" || c.kind == "C4"
    let ink=if dark {#xffffff} else {#x1d1d1f}
    let muted=if dark {#xbcbcc0} else {#x666666}
    let blue=if dark {#x2997ff} else {#x0066cc}
    let iconName=if c.kind == "C3" {"arrow"} elif c.kind == "C4" {"turn"} else {"pin"}
    let iconSuffix=if dark {"-white"} else {""}
    let Txt=BodyText{draw_text.color: ink}
    let Cap=Caption{draw_text.color: muted}
    let Num=Fact{draw_text.color: ink}
    SolidView{width: Fill height: Fill flow: Down draw_bg.color: if dark {#x272729} else {#xffffff}
    ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 24 right: 24 top: 24 bottom: 16} spacing: 0
        if c.stage == "preparing" {
            Title{text: "准备出发" draw_text.color: ink}
            View{width: Fill height: 16}
            preparing_caption := Cap{text: "路线已经确认准备实际出发"}
            View{width: Fill height: 32}
            for i in 0 {View{height: 0}}
        } elif c.stage == "arrived" {
            Title{text: v.title draw_text.color: ink}
            View{width: Fill height: 24}
            for i in 0 {View{height: 0}}
        } elif c.stage == "intent" || c.stage == "intent_confirmed" {
            Title{text: v.title draw_text.color: ink}
            if v.subtitle != "" {View{width: Fill height: 12};Cap{draw_text.text_style.font_size: 12.75 text: v.subtitle}}
            View{width: Fill height: 16}
            for i in 0 {View{height: 0}}
        } elif walking || c.stage == "waiting" || c.stage == "riding" {
            Title{text: v.title draw_text.color: ink}
            if walking == false && v.subtitle != "" {View{width: Fill height: 12};Cap{draw_text.text_style.font_size: 12.75 text: v.subtitle}}
            View{width: Fill height: 24}
            for i in 0 {View{height: 0}}
        } else {
        View{width: Fill height: 20 flow: Right spacing: 8 clip_y: false align: Align{y: if c.kind == "C5" {0} else {0.5}}
            if c.kind != "C5" {Icon{draw_svg.svg: http_resource("{{assets}}/assets/onway-"+iconName+iconSuffix+".svg")}}
            Cap{width: Fill text: v.eyebrow}
            if c.kind == "C5" {Icon{width: 40 height: 40 draw_svg.svg: http_resource("{{assets}}/assets/onway-check.svg")}}
        }
        View{width: Fill height: 12}
        Title{text: v.title draw_text.color: ink}
        if v.subtitle != "" {View{width: Fill height: 12};Cap{draw_text.text_style.font_size: 12.75 text: v.subtitle}}
        View{width: Fill height: if c.stage == "intent" || c.stage == "intent_confirmed" {16} else {24}}
            for i in 0 {View{height: 0}}
        }
        View{width: Fill height: Fit flow: Right spacing: 24
            Cap{width: Fill text: v.heroLabel}
            if c.kind == "C1" || walking || c.stage == "waiting" {arrival_label := Cap{width: Fill text: "预计到达"}}
        }
        View{width: Fill height: 12}
        View{width: Fill height: Fit flow: Right spacing: 24 align: Align{y: 0.85}
            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.85}
                Label{padding: 0 width: Fit height: Fit text: v.hero draw_text.color: ink draw_text.text_style: Bold{font_size: if v.hero.len() > 9 {24} else {42}}}
                if v.unit != "" {Label{padding: 0 width: Fit height: Fit text: v.unit draw_text.color: ink draw_text.text_style: Regular{font_size: 18}}}
            }
            if c.kind == "C1" || walking || c.stage == "waiting" {arrival_value := Num{width: Fill text: if v.arrival != "" {v.arrival} else {"方案待选"}}}
        }
        View{width: Fill height: 12}
        if c.stage == "waiting" && v.busDetail != "" {waiting_distance := Cap{text: v.busDetail}}
        if v.secondary != "" {Txt{text: v.secondary}}
        if c.stage == "intent" || c.stage == "intent_confirmed" {
            View{width: Fill height: 24}
            intent_route_box := RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 8 draw_bg.color: #xf5f5f7 draw_bg.border_radius: 10
                intent_destination := Txt{draw_text.text_style: Bold{font_size: 15} text: "去"+v.intentDestination}
                intent_route := Txt{text: v.intentRoute+" · "+v.duration}
                intent_timing := Cap{text: v.intentTimingNote}
            }
            View{width: Fill height: 16}
            intent_weather_box := RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 8 draw_bg.color: #xf5f5f7 draw_bg.border_radius: 10
                intent_weather_title := Txt{draw_text.text_style: Bold{font_size: 15} text: "今天的天气"}
                intent_weather := Txt{text: v.intentWeather}
                intent_weather_note := Cap{text: v.intentWeatherNote}
            }
            for i in 0 {View{height: 0}}
        } elif c.kind == "C1" {
            View{width: Fill height: 12}
            View{width: Fill height: Fit flow: Right spacing: 24
                View{width: Fill height: Fit flow: Down spacing: 6 Cap{text: "路线距离"} Num{text: v.distance}}
                View{width: Fill height: Fit flow: Down spacing: 6 Cap{text: "预估时长"} Num{text: v.duration}}
            }
            View{width: Fill height: 24}
            if v.connection != "" {
                c1_connection_label := Cap{text: v.connectionLabel}
                View{width: Fill height: 12}
                if v.busVisible {
                    c1_bus_line := Txt{draw_text.text_style: Bold{font_size: 15} text: v.connection}
                    c1_bus_direction := Txt{padding: Inset{top: 4 bottom: 8} text: v.connectionCaption}
                    c1_bus_wait := Cap{text: v.connectionStatus}
                    c1_bus_distance := Cap{padding: Inset{top: 8} text: v.busDetail}
                    for i in 0 {View{height: 0}}
                } else {
                    Txt{draw_text.text_style: Bold{font_size: 15} text: v.connection}
                    View{width: Fill height: 8}
                    connection_caption := Txt{text: v.connectionCaption}
                    View{width: Fill height: 8}
                    connection_status := Cap{text: v.connectionStatus}
                    for i in 0 {View{height: 0}}
                }
            }
            for i in 0 {View{height: 0}}
        } elif c.kind == "C5" {
            if state.config.aiEnabled || state.trip.aiSummary != "" {
                View{height: 24 width: Fill}
                ai_summary_box := RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 12 draw_bg.color: #xf5f5f7 draw_bg.border_radius: 10
                    ai_summary_title := Txt{draw_text.text_style: Bold{font_size: 15} text: "AI行程总结"}
                    ai_summary_text := Txt{text: if state.trip.aiSummary != "" {state.trip.aiSummary} else {state.trip.aiSummaryStatus}}
                }
            }
            View{height: 24 width: Fill}
            SolidView{width: Fill height: 1 draw_bg.color: #xe0e0e0}
            if c.stage != "arrived" {
                Cap{padding: Inset{top: 12 bottom: 12} text: v.comparison}
                SolidView{width: Fill height: 1 draw_bg.color: #xe0e0e0}
            }
            View{height: 16 width: Fill}
            View{width: Fill height: Fit flow: Right Cap{text: "出发 → 到达"} Txt{width: Fit text: v.departed+" → "+v.ended}}
            View{height: 12 width: Fill}
            View{width: Fill height: Fit flow: Right Cap{text: "路线距离"} Txt{width: Fit text: v.distance}}
            View{height: 16 width: Fill}
            View{width: Fill height: Fit flow: Right spacing: 16
                for segment in v.segments {View{width: Fill height: Fit flow: Down spacing: 4 Num{draw_text.text_style.font_size: 15 text: segment.value} Cap{text: segment.label}}}
            }
            if c.stage != "arrived" {Cap{padding: Inset{top: 16} text: v.footer}}

        } else {
            if v.instruction != "" {
                View{height: 16 width: Fill}
                View{width: Fill height: Fit flow: Right spacing: 16 align: Align{y: 0.5}
                    Icon{width: 48 height: 40 draw_svg.svg: http_resource("{{assets}}/assets/onway-turn-white.svg")}
                    View{width: Fill height: Fit flow: Down spacing: 4
                        Txt{draw_text.text_style: Bold{font_size: 12.75} text: v.instruction}
                        Cap{text: v.instructionCaption}
                    }
                }
            }
            if c.kind == "C3" {
                View{height: 24 width: Fill}
                View{width: Fill height: Fit flow: Right spacing: 24
                    View{width: Fill height: Fit flow: Down spacing: 6 Cap{text: "预计下车"} Num{text: v.alight}}
                    View{width: Fill height: Fit flow: Down spacing: 6 Cap{text: "预计到达目的地"} Num{text: v.arrival}}
                }
            }
            if v.connection != "" && c.stage != "waiting" && c.stage != "riding" {
                View{height: 24 width: Fill}
                SolidView{width: Fill height: 1 draw_bg.color: #x38383a}
                View{height: 16 width: Fill}
                Cap{text: v.connectionLabel}
                View{height: 12 width: Fill}
                if v.busVisible {
                    bus_line := Txt{draw_text.text_style: Bold{font_size: 15} text: v.connection}
                    bus_direction := Txt{padding: Inset{top: 4 bottom: 8} text: v.connectionCaption}
                    bus_wait := Cap{text: v.connectionStatus}
                    bus_distance := Cap{padding: Inset{top: 8} text: v.busDetail}
                    for i in 0 {View{height: 0}}
                } else {
                    Txt{draw_text.text_style: Bold{font_size: 15} text: v.connection}
                    View{height: 4 width: Fill}
                    Txt{text: v.connectionCaption}
                    View{height: 8 width: Fill}
                    Cap{text: v.connectionStatus}
                    for i in 0 {View{height: 0}}
                }
            }
            if c.kind != "C3" && walking == false && c.stage != "waiting" {
                View{height: 16 width: Fill}
                SolidView{width: Fill height: 1 draw_bg.color: #x38383a}
                View{height: 16 width: Fill}
                View{width: Fill height: Fit flow: Right Txt{text: "预计到达目的地"} Txt{width: Fit draw_text.text_style: Bold{font_size: 12.75} text: v.arrival}}
            }

            for i in 0 {View{height: 0}}
        }
        for i in 0 {View{height: 0}}
    }
    SolidView{width: Fill height: 1 draw_bg.color: if dark {#x38383a} else {#xe0e0e0}}
    View{width: Fill height: Fit flow: Down padding: Inset{left: 24 right: 24 top: 16 bottom: 24} spacing: 8
        if c.stage == "intent" {
            if v.intentPreview {Action{text: "关闭预览" on_click: || send("intent_decline",{})};for i in 0 {View{height: 0}}} else {
            Action{text: v.confirmLabel on_click: || send("intent_confirm",{})}
            View{width: Fill height: 44 flow: Right spacing: 8 Flat{width: Fill text: "稍后提醒" on_click: || {snooze=true;ui.card.render()}} Flat{width: Fill text: "今天不去" on_click: || send("intent_decline",{})}}
            if snooze {for n in [10,20,30,60] {Secondary{text: "延后 "+n+" 分钟" on_click: || send("intent_snooze",{minutes: n})}}}
            for i in 0 {View{height: 0}}
            }
        } elif c.stage == "intent_confirmed" {
            Action{text: "选择出行方案" on_click: || send("show_routes",{})}
            Secondary{text: "今天不去" on_click: || send("intent_decline",{})}
        } elif c.stage == "arrived" {
            Action{text: "关闭总结" on_click: || send("close_summary",{})}
            Flat{width: Fill text: "还没到达" on_click: || send("not_arrived",{})}
        } elif c.stage == "canceled" {
            Action{text: "关闭总结" on_click: || send("close_summary",{})}
        } elif c.stage != "idle" {
            View{width: Fill height: 44 flow: Right align: Align{y: 0.5}
                View{width: Fill height: 1}
                Flat{text: "纠正状态" draw_text +: {color: blue color_hover: blue color_down: blue} on_click: || {correction=correction==false;ui.card.render()}}
            }
            if correction {
                ScrollYView{width: Fill height: 264 flow: Down padding: Inset{right: 12} spacing: 10
                for choice in c.corrections {
                    Secondary{text: choice.label on_click: || send("correct",{stage: choice.stage segment: choice.segment})}
                }
                end_button := Secondary{text: "结束当前行程" on_click: || send("cancel",{})}
                }
            }
        }
    }
    }
}
}}
}
