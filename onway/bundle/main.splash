// 在途 Onway · v0.4.0
// 产品原型与 PRD 对齐版：单主卡片、17 个关键页面、可信 50 米边界。
// 原型演示数据与真实定位/历史严格分开；演示到达不会写入真实历史。

let cfg = nil
let hist = []
let historyEdited = false
let screen = "welcome"
let previousScreen = "idle"
let settingsBack = "idle"
let historyBack = "idle"
let demoMode = true
let curLat = 0.0
let curLon = 0.0
let hasFix = false
let locationNote = "等待定位数据"
let locationAccuracy = 0.0
let lastFixEpoch = 0
let outsideHits = 0
let homeHits = 0
let workHits = 0
let liveTrip = nil
let setupNote = "当前显示原型示例地点"

let ink = #x1d1d1f
let sub = #x7a7a7a
let readable = #x666666
let blue = #x0066cc
let bright = #x2997ff
let pageBg = #xf5f5f7
let white = #xffffff
let hair = #xe0e0e0
let dark = #x272729
let dark2 = #x38383a
let darkSub = #xcccccc
let amber = #xff9f0a
let amberDark = #x8a4b00
let amberBg = #xfffff4e5
let inactive = #xe5e5ea
let green = #x30d158

fn seed(){
    cfg = {
        schema: 3,
        onboarded: false,
        homeName: "望京西园四区",
        workName: "中关村软件园",
        home: {lat: 39.99872, lon: 116.47291},
        work: {lat: 40.04828, lon: 116.29743},
        selectedPlan: 0,
        threshold: 10,
        backgroundLocation: true,
        anomalyNotice: true
    }
    hist = []
}

fn load(){
    if fs.exists("cfg.json") {
        let stored=fs.read("cfg.json")
        if stored.search("\"schema\"")>=0 {let c=stored.parse_json(); if c.schema==3 {cfg=c}}
        else {if fs.exists("legacy-cfg-v0.3.json")==false {fs.write("legacy-cfg-v0.3.json",stored)}}
    }
    if cfg == nil { seed() }; if fs.exists("history-edited.txt") {historyEdited=fs.read("history-edited.txt")=="true"}
    if fs.exists("hist.json") {let h=fs.read("hist.json").parse_json();if h!=nil {hist=h}}
    screen = "welcome"
    save()
}

fn save(){
    fs.write("cfg.json", cfg.to_json())
    fs.write("hist.json", hist.to_json())
}

fn distm(a, b, c, d){
    let x = (d - b) * cos((a + c) / 2 * 3.14159265 / 180)
    let y = c - a
    return sqrt(x * x + y * y) * 111320
}

fn readLocation(){
    let status = sys.gps("status")
    hasFix = false
    if sys.gps("ok") >= 1 {
        curLat = sys.gps("lat")
        curLon = sys.gps("lon")
        locationAccuracy = sys.gps("acc")
        lastFixEpoch = sys.gps("timestamp")
        let age = time_now() - lastFixEpoch
        if age >= -5 && age <= 60 && locationAccuracy >= 0 && locationAccuracy <= 50 {
            hasFix = true
            locationNote = "真实定位可用 · 精度约 " + round(locationAccuracy) + " 米"
        } else {
            if age > 60 { locationNote = "定位数据已过期，请稍后重试" }
            else { locationNote = "定位精度不足 · 约 " + round(locationAccuracy) + " 米" }
        }
    } else {
        if status == 3 { locationNote = "定位权限未开启，请检查系统设置" }
        elif status == 4 { locationNote = "系统暂无定位数据，请稍后重试" }
        elif status == 5 { locationNote = "定位服务异常，请重新打开应用" }
        elif status == 0 { locationNote = "当前设备定位不可用" }
        else { locationNote = "正在获取真实定位，请稍候" }
    }
}

fn isTripScreen(){
    if screen == "walking" || screen == "waiting" || screen == "riding" { return true }
    if screen == "transfer" || screen == "lastwalk" || screen == "gpslost" { return true }
    return false
}

fn setScreen(s){
    previousScreen = screen
    screen = s
    ui.board.render()
}

fn finishSetup(){
    cfg.onboarded = true
    save()
    setScreen("ready")
}

fn markHome(){
    readLocation()
    if hasFix {
        cfg.home = {lat: curLat, lon: curLon}
        cfg.homeCoordSystem = "wgs84"
        cfg.homeSource = "device"
        cfg.homeName = "当前位置（家）"
        setupNote = "已用可信定位标记家"
        save()
    } else { setupNote = locationNote }
    ui.board.render()
}

fn markWork(){
    readLocation()
    if hasFix {
        cfg.work = {lat: curLat, lon: curLon}
        cfg.workCoordSystem = "wgs84"
        cfg.workSource = "device"
        cfg.workName = "当前位置（目的地）"
        setupNote = "已用可信定位标记目的地"
        save()
    } else { setupNote = locationNote }
    ui.board.render()
}

fn startLiveTrip(){
    liveTrip = {started: time_now(), direction: "to_work", plan: cfg.selectedPlan}
    screen = "walking"
}

fn finishLiveTrip(){
    if liveTrip != nil {
        let d = round((time_now() - liveTrip.started) / 60)
        if d < 1 { d = 1 }
        hist.push({epoch: liveTrip.started, direction: liveTrip.direction, plan: liveTrip.plan, durMin: d})
        save()
    }
    liveTrip = nil
    screen = "arrived"
}

// 两次连续越界才采信，避免单次 GPS 跳点。
fn applyTrustedBoundary(){
    if demoMode || cfg == nil || cfg.onboarded == false || hasFix == false { return }
    let dh = distm(curLat, curLon, cfg.home.lat, cfg.home.lon)
    let dw = distm(curLat, curLon, cfg.work.lat, cfg.work.lon)
    if dh > 50 { outsideHits = outsideHits + 1 } else { outsideHits = 0 }
    if dh < 50 { homeHits = homeHits + 1 } else { homeHits = 0 }
    if dw < 50 { workHits = workHits + 1 } else { workHits = 0 }
    if (screen == "idle" || screen == "ready") && outsideHits >= 2 { startLiveTrip() }
    if isTripScreen() && homeHits >= 2 { liveTrip = nil; screen = "canceled" }
    if isTripScreen() && workHits >= 2 { finishLiveTrip() }
}

fn refresh(){
    readLocation()
    applyTrustedBoundary()
    ui.board.render()
}

fn openSettings(){ settingsBack = screen; screen = "settings"; ui.board.render() }
fn openHistory(back){ historyBack = back; screen = "history"; ui.board.render() }
fn closeOverlay(){
    if screen == "history" { screen = historyBack }
    elif screen == "settings" { screen = settingsBack }
    else { screen = "idle" }
    ui.board.render()
}
fn toggleTracking(){ if demoMode { demoMode = false } else { demoMode = true }; ui.board.render() }

start_timeout(0.05, || {load();ui.board.render()})
start_interval(3.0, || {if screen == "locationstatus" || screen == "locationeditor" {readLocation();ui.location_status.set_text(locationNote)} elif screen == "locations" {readLocation()}})

let editorHome = true
let editorBack = "locations"
let editorText = ""
let manualMinutes = "47"
let notice = ""
fn editLocation(home){editorHome=home; editorBack=screen; if home {editorText=cfg.homeName} else {editorText=cfg.workName}; setScreen("locationeditor")}
fn saveLocation(){if editorText.trim().len()>0 {if editorHome {cfg.homeName=editorText} else {cfg.workName=editorText}; save(); setScreen(editorBack)}}
fn selectPlan(i){cfg.selectedPlan=i;save();ui.board.render()}
fn togglePreference(i){if i==0 {cfg.backgroundLocation = cfg.backgroundLocation == false} else {cfg.anomalyNotice = cfg.anomalyNotice == false};save();ui.board.render()}
fn setThreshold(n){cfg.threshold=n;save();setScreen("settings")}
fn openCorrection(){previousScreen=screen;setScreen("correction")}
fn clearHistory(){hist=[];historyEdited=true;fs.write("history-edited.txt","true");save();setScreen("history")}
fn manualTrip(){let d=manualMinutes.trim().to_f64(); if d>=1 && d<=1440 {hist.push({epoch:time_now(),direction:"to_work",plan:cfg.selectedPlan,durMin:round(d)});historyEdited=true;fs.write("history-edited.txt","true");save();setScreen("history")} else {notice="请输入 1～1440 分钟";ui.board.render()}}
fn historyAverage(){let total=0;for trip in hist {total=total+trip.durMin};if hist.len()>0 {return round(total/hist.len())};return 0}

let OnwayRegular = TextStyle{font_family: FontFamily{latin := FontMember{res: http_resource("{{assets}}/assets/NotoSansSC-Onway-Regular.ttf") asc: -0.2 desc: 0.08 weight: 400}} line_spacing: 1.0}
let OnwayBold = TextStyle{font_family: FontFamily{latin := FontMember{res: http_resource("{{assets}}/assets/NotoSansSC-Onway-Bold.ttf") asc: -0.2 desc: 0.08 weight: 700}} line_spacing: 1.0}
