let Regular = TextStyle{font_family: FontFamily{latin := FontMember{res: http_resource("{{assets}}/assets/NotoSansSC-AI-Regular.otf") asc: -0.2 desc: 0.08 weight: 400}} font_size: 12.75 line_spacing: 1.0}
let Bold = Regular{font_family: FontFamily{latin := FontMember{res: http_resource("{{assets}}/assets/NotoSansSC-Onway-Bold.otf") asc: -0.2 desc: 0.08 weight: 700} fallback := FontMember{res: http_resource("{{assets}}/assets/NotoSansSC-AI-Regular.otf") asc: -0.2 desc: 0.08 weight: 400}}}
// Onway 0.6.0. UI never owns the trip and never reads a service secret.
let state = nil
let health = nil
let page = "home"
let dirty = false
let text = ""
let dateFilter = ""
let deletingHistory = nil
let editingPlaces = false
let choosingOrigin = false
let searchDue = 0
let searchPending = ""
let searchReady = false
let placeSavePending = ""
let startPending = ""
let placeName = ""
let placeType = "custom"
let editingId = nil
let savedPlace = nil
let selectedSegment = 0
let departText = "08:00"
let returnText = "18:00"
let leadText = "10"
let exceptionsText = ""
let arrivalText = ""
let commuteOrigin = ""
let commuteDest = ""
let commuteDays = [true,true,true,true,true,false,false]
let commuteDateMode = "official"
let choosingDays = false
let notice = ""
let instance = "main-" + random_u32()
let serial = 0
let pending = ""
let navigationSeen = ""
let expandedRoute = ""
let backendDeadline = time_now() + 12
let backendUnavailable = false

fn send(action, payload){
    serial = serial + 1
    let id = instance + "-" + round(time_now() * 1000) + "-" + serial
    pending = id
    let tripId = nil
    if state != nil && state.trip != nil {tripId = state.trip.id}
    fs.mkdir("commands")
    fs.write("commands/cmd-" + id + ".json", {id: id action: action payload: payload tripId: tripId}.to_json())
    notice = "正在处理…"
    dirty = false
}
fn go(next){if next == "home" {send("refresh_location",{})};if next == "services" {send("check_services",{})};page=next;dirty=false;notice="";searchDue=0;text="";searchReady=false;ui.board.render()}
fn query(){send("search",{text: text});searchPending=pending;searchReady=false;ui.board.render()}
fn pick(p, origin){
    send(if origin {"set_origin"} else {"plan_destination"}, {place: p})
    text="";searchReady=false;searchDue=0
    if origin {choosingOrigin=false} else {page="routes";editingPlaces=false;expandedRoute="";state.routes=[];state.selected=nil}
    ui.board.render()
}
fn plan(){send("query_routes",{});go("routes")}
fn editPlace(kind, existing){
    savedPlace=existing
    placeType=kind
    editingId=if existing != nil {existing.id} elif kind == "custom" {nil} else {kind}
    placeName=if existing != nil && kind == "custom" {existing.name} else {""}
    editingPlaces=false;choosingOrigin=false;searchPending="";placeSavePending=""
    go(if existing != nil {"place_details"} else {"place_search"})
}
fn choosePlace(p){
    send("save_place",{place: p name: if placeName != "" {placeName} else {p.name} type: placeType placeId: editingId})
    placeSavePending=pending
    ui.board.render()
}
fn saveHabits(){
    let days=[]
    for i in 7 {if commuteDays[i] {days.push(i)}}
    let exceptions=[]
    if exceptionsText != "" {exceptions=exceptionsText.split(",")}
    send("commute",{originId: commuteOrigin destinationId: commuteDest days: days depart: departText returnTime: returnText lead: leadText.to_f64() exceptions: exceptions requiredArrival: arrivalText dateMode: commuteDateMode})
    ui.board.render()
}
fn poll(){
    if fs.exists("worker-health.json") {health=fs.read("worker-health.json").parse_json()}
    if fs.exists("view-state.json") == false {
        if backendUnavailable == false && time_now() >= backendDeadline {backendUnavailable=true;ui.board.render()}
        return
    }
    let fresh=fs.read("view-state.json").parse_json()
    if fresh == nil || fresh.schema != 6 {return}
    let changed = state == nil || fresh.revision != state.revision
    let opening=state == nil
    state=fresh
    if opening {send("refresh_location",{})}
    if state.navigation != nil && state.navigation.id != navigationSeen {
        navigationSeen=state.navigation.id
        page=if state.navigation.page == "home" {"home"} else {"routes"}
        dirty=false
        if page == "home" {choosingOrigin=false;editingPlaces=false;text="";searchDue=0;searchReady=false}
    }
    for id in state.receipts {
        if id == pending {notice="";pending=""}
        if id == searchPending {searchPending="";searchReady=true}
        if id == startPending {startPending="";if state.trip != nil && state.trip.status == "preparing" {page="home";dirty=false}}
        if id == placeSavePending {placeSavePending="";page="home";text="";dirty=false;searchReady=false}
    }
    if changed && dirty == false {ui.board.render()}
    elif dirty {ui.status.set_text("")}
}
start_timeout(0.1, || poll())
start_interval(2.0, || poll())
start_interval(0.25, || {if searchDue > 0 && time_now() >= searchDue {searchDue=0;if text != "" {query()}}})

let BodyText = Label{padding: 0 width: Fill height: Fit draw_text.color: #x1d1d1f draw_text.text_style: Regular draw_text.wrap: TextWrap.Word}
let Caption = BodyText{draw_text.color: #x666666 draw_text.text_style.font_size: 9.75}
let Heading = BodyText{height: 40 draw_text.text_style: Bold{font_size: 27}}
let SmallHeading = BodyText{draw_text.text_style: Bold{font_size: 15}}
let Action = ButtonFlat{width: Fill height: 48 padding: Inset{left: 16 right: 16 top: 10 bottom: 10} draw_bg +: {color: #x0066cc color_hover: #x0071e3 color_down: #x0055aa border_radius: 24 border_size: 0} draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff text_style: Regular}}
let Secondary = Action{height: 40 draw_bg +: {color: #xf5f5f7 color_hover: #xe8e8ed color_down: #xdedee5 border_radius: 10} draw_text +: {color: #x0066cc color_hover: #x0066cc color_down: #x0066cc}}
let Entry = TextInput{width: Fill height: 46 draw_text.text_style: Regular draw_text.color: #x1d1d1f draw_text.color_empty: #x666666 draw_bg.color: #xf5f5f7}
let Rule = SolidView{width: Fill height: 1 draw_bg.color: #xe0e0e0}
let Flat = ButtonFlat{width: Fit height: 44 padding: 0 draw_bg +: {color: #x00000000 color_hover: #x00000000 color_down: #x00000000 border_size: 0} draw_text +: {color: #x0066cc color_hover: #x0066cc color_down: #x0066cc text_style: Regular}}
let Chip = Flat{height: 50 padding: Inset{left: 14 right: 14 top: 12 bottom: 12} draw_bg +: {color: #xf5f5f7 color_hover: #xe8e8ed color_down: #xdedee5 border_radius: 25 border_size: 0} draw_text +: {color: #x1d1d1f color_hover: #x1d1d1f color_down: #x1d1d1f}}
let EmptyChip = Chip{draw_bg +: {color: #xffffff color_hover: #xf5f5f7 color_down: #xe8e8ed border_size: 1 border_color: #xe0e0e0} draw_text +: {color: #x666666 color_hover: #x666666 color_down: #x666666}}
let Icon = Svg{width: 20 height: 20 animating: false draw_svg.preserve_viewbox: true draw_svg.preserve_aspect: true}


SolidView{width: Fill height: Fill flow: Down draw_bg.color: #xffffff
board := View{width: Fill height: Fill flow: Down spacing: 0 on_render: || {
if state == nil {
    View{width: Fill height: Fill flow: Down padding: 24 spacing: 20
        Heading{text: "在途"}
        BodyText{text: if backendUnavailable {"此宿主尚未接入在途后台"} else {"正在连接本机后台…"}}
        Caption{text: "当前完整功能需要在途 Windows 演示包中的配套后台。单独安装脚本包暂不能完成路线查询与行程管理。"}
        Caption{text: "请使用项目 Releases 中的 Windows 演示包。App Hub 接入正在申请人工审核。"}
        Secondary{text: "重新检查" on_click: || {backendDeadline=time_now()+12;backendUnavailable=false;poll();ui.board.render()}}
    }
} else {
    View{width: Fill height: if page == "home" {67} else {64} flow: Right padding: Inset{left: 24 right: 24 top: 8 bottom: 8} align: Align{y: 0.5}
        if page == "home" {
            SmallHeading{width: Fill text: "Onway 在途"}
            Flat{text: "我的" on_click: || go("mine")}
        } else {
            Flat{text: if page == "routes" || page == "mine" || page == "place_search" || page == "place_details" {"返回出行"} else {"返回我的"} on_click: || {if page == "routes" || page == "mine" || page == "place_search" || page == "place_details" {go("home")} else {go("mine")}}}
            View{width: Fill height: 1}
            if page == "place_search" {SmallHeading{width: Fit text: if placeType == "home" {"设置家"} elif placeType == "work" {"设置公司"} elif placeType == "school" {"设置学校"} else {"设置常用地点"}}}
        }
    }
    Rule{}
    ScrollYView{width: Fill height: Fill flow: Down padding: 24 spacing: 0
    if page == "home" {
        home_surface := View{width: Fill height: 460+state.config.places.len()*50 flow: Overlay clip_y: false
        View{width: Fill height: Fill flow: Down
        View{width: Fill height: 105 flow: Down spacing: 8
            View{width: Fill height: 20 flow: Right spacing: 8 align: Align{y: 0.5}
                RoundedView{width: 8 height: 8 draw_bg.color: #x0066cc draw_bg.border_radius: 4}
                Caption{text: if state.originMode == "manual" {"手动起点"} else {"当前位置"}}
            }
            View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5}
                View{width: Fill height: Fit flow: Down spacing: 8
                    SmallHeading{text: if state.origin != nil {state.origin.name} else {"尚未取得位置"}}
                }
                EmptyChip{height: 40 text: if choosingOrigin {"取消"} else {"手动选择"} draw_text.color: #x1d1d1f on_click: || {choosingOrigin=choosingOrigin==false;text="";searchReady=false;searchDue=0;searchPending="";dirty=false;ui.board.render()}}
            }
        }
        View{height: 24 width: Fill}
        RoundedView{width: Fill height: 54 flow: Right padding: Inset{left: 20 right: 16 top: 4 bottom: 4} align: Align{y: 0.5} draw_bg.color: #xf5f5f7 draw_bg.border_radius: 27 draw_bg.border_size: 1 draw_bg.border_color: #xe0e0e0
            Entry{height: 46 padding: 0 text: text empty_text: if choosingOrigin {"搜索本次起点"} else {"你要去哪儿？"} draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 color_down: #x00000000 color_empty: #x00000000 color_disabled: #x00000000 border_size: 0} on_change: |t| {text=t;dirty=true;searchDue=time_now()+0.6} on_return: |t| {searchDue=0;query()}}
        }
        View{height: 32 width: Fill}
        View{width: Fill height: 26 flow: Right align: Align{y: 0.5}
            BodyText{width: Fill draw_text.text_style: Bold{font_size: 12.75} text: "常用地点"}
            Flat{height: 26 draw_text.text_style.font_size: 11.25 text: if editingPlaces {"完成"} else {"编辑"} on_click: || {editingPlaces=editingPlaces==false;dirty=false;ui.board.render()}}
        }
        View{height: 16 width: Fill}
        View{width: Fill height: Fit flow: Right{wrap: true} spacing: 10
            for kind in ["home","work","school"] {
                let hidden=false
                if state.config.hiddenPlaceTypes != nil {for k in state.config.hiddenPlaceTypes {if k == kind {hidden=true}}}
                if hidden == false {
                let found=false
                let label=if kind == "home" {"家"} elif kind == "work" {"公司"} else {"学校"}
                for p in state.config.places {if p.type == kind {found=true;
                    View{width: Fit height: 60 flow: Overlay clip_x: false clip_y: false
                        Chip{margin: Inset{top: 6} text: label on_click: || {if editingPlaces == false {editPlace(kind,p)}}}
                        if editingPlaces {Flat{width: 22 height: 22 align: Align{x: 0.5 y: 0.5} margin: Inset{left: if kind == "home" {30} else {47}} text: "×" draw_text +: {color: #xff3b30 color_hover: #xff3b30 color_down: #xff3b30 text_style: Regular{font_size: 14}} on_click: || send("remove_place",{placeId: p.id})}}
                    }
}}
                if found == false {
                    View{width: Fit height: 60 flow: Overlay clip_x: false clip_y: false
                        Chip{margin: Inset{top: 6} text: label on_click: || {if editingPlaces == false {editPlace(kind,nil)}}}
                        if editingPlaces {Flat{width: 22 height: 22 margin: Inset{left: if kind == "home" {30} else {47}} text: "×" draw_text +: {color: #xff3b30 color_hover: #xff3b30 color_down: #xff3b30 text_style: Regular{font_size: 14}} on_click: || send("remove_place",{type: kind})}}
                    }
                }
                }
            }
            for p in state.config.places {if p.type == "custom" {
                View{width: 160 height: 60 flow: Overlay clip_x: false clip_y: false
                    Chip{width: 160 margin: Inset{top: 6} text: p.name on_click: || {if editingPlaces == false {editPlace("custom",p)}}}
                    if editingPlaces {Flat{width: 22 height: 22 margin: Inset{left: 145} text: "×" draw_text +: {color: #xff3b30 color_hover: #xff3b30 color_down: #xff3b30 text_style: Regular{font_size: 14}} on_click: || send("remove_place",{placeId: p.id})}}
                }
            }}
            EmptyChip{margin: Inset{top: 6} text: "添加自定义地点" draw_bg.border_color: #x0066cc draw_text.color: #x0066cc on_click: || editPlace("custom",nil)}
        }
        View{width: Fill height: 32}
        home_commute_preview := Secondary{text: "预览推荐卡片" on_click: || {send("preview_intent",{});ui.board.render()}}
        View{width: Fill height: 12}
        home_preview_status := Caption{text: state.previewStatus}
        }
        if searchReady && state.search.len() > 0 && text != "" {
            RoundedView{width: Fill height: Fit margin: Inset{top: 191} flow: Down draw_bg.color: #xffffff draw_bg.border_radius: 9 draw_bg.border_size: 1 draw_bg.border_color: #xe0e0e0
                ScrollYView{width: Fill height: 220 flow: Down
                    for p in state.search {
                        GestureView{width: Fill height: Fit flow: Down padding: Inset{left: 20 right: 20 top: 16 bottom: 16} spacing: 4 on_tap: |x,y| {pick(p,choosingOrigin);text=""}
                            BodyText{draw_text.text_style: Bold{font_size: 12.75} text: p.name}
                            Caption{draw_text.text_style.font_size: 11.25 text: p.address}
                        }
                        Rule{}
                    }
                }
            }
        }
        }
    } elif page == "place_details" {
        Heading{text: if placeType == "home" {"家"} elif placeType == "work" {"公司"} elif placeType == "school" {"学校"} else {"常用地点"}}
        View{width: Fill height: 24}
        saved_place_name := SmallHeading{text: savedPlace.name}
        View{width: Fill height: 16}
        saved_place_address := BodyText{text: savedPlace.address}
        View{width: Fill height: 32}
        saved_place_edit := Secondary{text: "修改位置" on_click: || go("place_search")}
        for i in 0 {View{width: Fill height: 0}}
    } elif page == "place_search" {
        if placeType == "custom" {
            Entry{text: placeName empty_text: "常用地点名称（可选）" on_change: |t| {placeName=t;dirty=true}}
            View{width: Fill height: 16}
        }
        RoundedView{width: Fill height: 54 flow: Right padding: Inset{left: 20 right: 16 top: 4 bottom: 4} align: Align{y: 0.5} draw_bg.color: #xf5f5f7 draw_bg.border_radius: 27 draw_bg.border_size: 1 draw_bg.border_color: #xe0e0e0
            place_query := Entry{height: 46 padding: 0 text: text empty_text: "搜索地址" draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 color_down: #x00000000 color_empty: #x00000000 color_disabled: #x00000000 border_size: 0} on_change: |t| {text=t;dirty=true;searchReady=false;searchDue=time_now()+0.6} on_return: |t| {searchDue=0;query()}}
        }
        if searchReady && text != "" {
            View{width: Fill height: 16}
            if state.search.len() == 0 {Caption{text: state.queryStatus}}
            for p in state.search {
                GestureView{width: Fill height: Fit flow: Down padding: Inset{top: 16 bottom: 16} spacing: 6 on_tap: |x,y| {if placeSavePending == "" {choosePlace(p)}}
                    BodyText{draw_text.text_style: Bold{font_size: 12.75} text: p.name}
                    Caption{draw_text.text_style.font_size: 11.25 text: p.address}
                }
                Rule{}
            }
        }
    } elif page == "routes" {
        Heading{text: "选择出行方案"}
        View{width: Fill height: 24}
        if state.config.aiEnabled {recommendation_status := Caption{text: state.recommendationStatus};View{width: Fill height: 12}}
        for r in state.routes {
            RoundedView{width: Fill height: Fit flow: Down draw_bg.color: #xffffff draw_bg.border_radius: 9 draw_bg.border_size: if state.selected == r.id {2} else {1} draw_bg.border_color: if state.selected == r.id {#x0066cc} else {#xe0e0e0}
                GestureView{width: Fill height: Fit flow: Down padding: Inset{left: 20 right: 20 top: 16 bottom: 12} spacing: 4 on_tap: |x,y| {send("select_route",{routeId: r.id});ui.board.render()}
                    View{width: Fill height: 42 flow: Right align: Align{y: 0.5} spacing: 4
                        Label{padding: 0 width: Fit height: Fit draw_text.color: #x1d1d1f draw_text.text_style: Bold{font_size: 21} text: if r.durationMinutes != nil {""+r.durationMinutes} else {"—"}}
                        BodyText{width: Fit text: "分钟"}
                        View{width: Fill height: 1}
                        Caption{width: Fit draw_text.color: #x0066cc text: if r.recommended {"AI推荐"} else {""}}
                        RoundedView{width: 24 height: 24 align: Align{x: 0.5 y: 0.5} draw_bg.color: if state.selected == r.id {#x0066cc} else {#xffffff} draw_bg.border_color: #xe0e0e0 draw_bg.border_size: if state.selected == r.id {0} else {1} draw_bg.border_radius: 12
                            Label{padding: 0 width: Fit height: Fit text: if state.selected == r.id {"✓"} else {""} draw_text.color: #xffffff draw_text.text_style: Regular{font_size: 12.75}}
                        }
                    }
                    BodyText{height: 25.5 text: r.displaySummary}
                    Caption{height: 19.5 text: if r.distance != nil {""+round(r.distance/100)/10+" 公里 · 步行 "+if r.walkingDistance != nil {""+round(r.walkingDistance)} else {"未知"}+" 米 · 换乘 "+r.transfers+" 次"} else {"暂无距离数据"}}
                    Caption{height: 19.5 text: "预计 "+r.arrivalText+" 到达"}
                }
                View{width: Fill height: 44 flow: Right padding: Inset{left: 20 right: 20} align: Align{y: 0.5}
                    details_button := Flat{height: 32 draw_text.text_style.font_size: 9.75 text: if expandedRoute == r.id {"收起路线步骤"} else {"查看路线步骤"} on_click: || {expandedRoute=if expandedRoute == r.id {""} else {r.id};ui.board.render()}}
                    View{width: Fill height: 1}
                    Caption{width: Fit draw_text.color: #x0066cc text: if expandedRoute == r.id {"−"} else {"＋"}}
                }
                if expandedRoute == r.id {View{width: Fill height: Fit flow: Down padding: Inset{left: 20 right: 20 bottom: 16} spacing: 8 for seg in r.segments {Caption{text: seg.name+if seg.to != "" {" · 至 "+seg.to} else {""}}}}}
            }
            View{width: Fill height: 12}
        }
        if state.routes.len() == 0 {Caption{text: state.queryStatus};Flat{text: "重新查询路线" on_click: || plan()}}
    } elif page == "mine" {
        Heading{text: "我的"}
        View{width: Fill height: 24}
        for item in [{id:"location" name:"定位" icon:"pin" sub:if state.config.tracking {"定位观察已开启"} else {"定位观察未开启"}}, {id:"history" name:"历史记录" icon:"clock" sub:"已保存 "+state.history.len()+" 条行程"}, {id:"reminders" name:"提醒" icon:"bell" sub:if state.config.reminders {"应用提醒已开启"} else {"应用提醒未开启"}}, {id:"services" name:"服务配置" icon:"key" sub:"MiniMax / 地图服务"}, {id:"habits" name:"出行习惯" icon:"habit" sub:"交通偏好与固定通勤"}] {
            GestureView{width: Fill height: Fit flow: Right padding: Inset{top: 12 bottom: 12} spacing: 16 align: Align{y: 0.5} on_tap: |x,y| {
                if item.id == "habits" {let c=state.config.commute;departText=c.depart;returnText=c.returnTime;leadText=""+c.lead;arrivalText=if c.requiredArrival != nil {c.requiredArrival} else {""};exceptionsText="";for d in c.exceptions {if exceptionsText != "" {exceptionsText=exceptionsText+","};exceptionsText=exceptionsText+d};commuteOrigin=c.originId;commuteDest=c.destinationId;for i in 7 {commuteDays[i]=false};for d in c.days {commuteDays[d]=true}}
                go(item.id)
            }
                Icon{draw_svg.svg: http_resource("{{assets}}/assets/onway-"+item.icon+".svg")}
                View{width: Fill height: Fit flow: Down spacing: 4 BodyText{height: 25.5 draw_text.text_style: Bold{font_size: 12.75} text: item.name} Caption{height: 19.5 text: item.sub}}
                Caption{width: Fit text: "›" draw_text.text_style.font_size: 18}
            }
            Rule{}
        }
        View{height: 24 width: Fill}
        RoundedView{width: Fill height: Fit flow: Right padding: 16 spacing: 12 draw_bg.color: #xf5f5f7 draw_bg.border_radius: 5.5
            Icon{draw_svg.svg: http_resource("{{assets}}/assets/onway-shield.svg")}
            BodyText{draw_text.text_style.font_size: 11.25 text: "个人记录保存在设备上。"}
        }
    } elif page == "location" {
        Heading{text: "定位"}
        View{width: Fill height: 12}
        BodyText{text: state.locationStatus}
        View{width: Fill height: 24}
        Action{text: if state.config.tracking {"关闭定位"} else {"开启定位"} on_click: || send("toggle",{field: "tracking"})}
        View{width: Fill height: 12}
        Secondary{text: "重新定位" on_click: || send("refresh_location",{})}
        View{width: Fill height: 12}
        location_permissions := Secondary{text: "打开 Windows 定位权限" on_click: || send("location_settings",{})}
    } elif page == "reminders" {
        Heading{text: "提醒"}
        View{width: Fill height: 24}
        Action{text: if state.config.reminders {"关闭应用提醒"} else {"开启应用提醒"} on_click: || send("toggle",{field: "reminders"})}
        View{width: Fill height: 20}
        notification_permissions := Secondary{text: "打开 Windows 通知设置" on_click: || send("notification_settings",{})}
    } elif page == "services" {
        Heading{text: "服务配置"}
        View{width: Fill height: 24}
        let aiConnection=if health != nil && health.connections != nil {health.connections.minimax} else {"正在检查"}
        ai_connection_line := BodyText{text: "AI API 接口："+aiConnection}
        View{width: Fill height: 16}
        let mapConnection=if health != nil && health.connections != nil {health.connections.amap} else {"正在检查"}
        map_connection_line := BodyText{text: "高德 API 接口："+mapConnection}
        View{width: Fill height: 16}
        let busConnection=if health != nil && health.connections != nil && health.connections.beijing_bus != nil {health.connections.beijing_bus} else {"正在检查"}
        bus_connection_line := BodyText{text: "北京公交 API 接口："+busConnection}
        View{width: Fill height: 20}
        let weatherConnection=if health != nil && health.connections != nil && health.connections.weather != nil {health.connections.weather} else {"正在检查"}
        weather_connection_line := BodyText{text: "天气 API 接口："+weatherConnection}
    } elif page == "history" {
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
            Heading{width: Fill text: "历史记录"}
            if state.history.len() > 0 {Flat{text: "清空全部" on_click: || go("clear_history")}}
        }
        View{width: Fill height: 24}
        Entry{text: dateFilter empty_text: "按日期筛选，例如 2026-10-06" on_change: |t| {dateFilter=t;dirty=true} on_return: |t| {dirty=false;ui.board.render()}}
        View{width: Fill height: 16}
        Secondary{text: "查询记录" on_click: || {dirty=false;ui.board.render()}}
        View{width: Fill height: 24}
        for h in state.history {
            if dateFilter == "" || h.date == dateFilter {
                RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 4 draw_bg.color: #xf5f5f7 draw_bg.border_radius: 9
                    BodyText{text: h.originName+" → "+h.destinationName}
                    Caption{text: h.date+" · "+h.resultText}
                    Caption{text: "实际起止："+h.startedText+" – "+h.endedText}
                    if h.duration != nil {Caption{text: "耗时 "+round(h.duration/60)+" 分钟"}}
                    for s in h.segments {Caption{text: s.stageText+if s.uncertain {" · 含定位中断，可靠时长未知"} elif s.endedAt != nil {" · "+round((s.endedAt-s.startedAt)/60)+" 分钟"} else {" · 时间未知"}}}
                    Flat{text: "删除" draw_text.color: #xff3b30 draw_text.color_hover: #xff3b30 draw_text.color_down: #xd70015 on_click: || {deletingHistory=h;go("delete_history")}}
                }
            }
        }
    } elif page == "delete_history" {
        Heading{text: "删除这条记录？"}
        View{width: Fill height: 20}
        if deletingHistory != nil {
            BodyText{text: deletingHistory.originName+" → "+deletingHistory.destinationName}
            Caption{text: deletingHistory.date+" · "+deletingHistory.startedText+" – "+deletingHistory.endedText}
            View{width: Fill height: 24}
            history_delete_confirm := Action{text: "确认删除" on_click: || {send("delete_history",{id: deletingHistory.id});deletingHistory=nil;go("history")}}
        }
        history_delete_cancel := Secondary{text: "取消" on_click: || {deletingHistory=nil;go("history")}}
    } elif page == "clear_history" {
        Heading{text: "清空全部历史？"}
        Caption{text: "将删除本机历史与学习摘要，无法恢复。"}
        history_clear_confirm := Action{text: "确认清空" on_click: || {send("clear_history",{});go("history")}}
        history_clear_cancel := Secondary{text: "取消" on_click: || go("history")}
    } elif page == "habits" {
        Heading{text: "出行习惯"}
        View{width: Fill height: 24}
        ai_toggle := Action{text: if state.config.aiEnabled {"关闭 AI 功能"} else {"开启 AI 功能"} on_click: || send("toggle",{field: "aiEnabled"})}
        View{width: Fill height: 28}
        SmallHeading{text: "出行方式"}
        View{width: Fill height: 12}
        View{width: Fill height: Fit flow: Right spacing: 8
            for option in [{id:"all" name:"不限"},{id:"transit" name:"公共交通"},{id:"walk" name:"步行"}] {
                Secondary{draw_bg.color: if state.config.preferences.mode == option.id {#x0066cc} else {#xf5f5f7} draw_bg.color_hover: if state.config.preferences.mode == option.id {#x0066cc} else {#xe8e8ed} draw_bg.color_down: if state.config.preferences.mode == option.id {#x0055aa} else {#xdedee5} draw_text.color_hover: if state.config.preferences.mode == option.id {#xffffff} else {#x0066cc} draw_text.color_down: if state.config.preferences.mode == option.id {#xffffff} else {#x0066cc} draw_text.color: if state.config.preferences.mode == option.id {#xffffff} else {#x0066cc} text: option.name on_click: || send("preferences",{mode: option.id route: state.config.preferences.route})}
            }
        }
        View{width: Fill height: 28}
        SmallHeading{text: "路线优先"}
        View{width: Fill height: 12}
        View{width: Fill height: Fit flow: Right spacing: 8
            for option in [{id:"fast" name:"最快"},{id:"lesswalk" name:"少步行"},{id:"lesstransfer" name:"少换乘"}] {
                Secondary{draw_bg.color: if state.config.preferences.route == option.id {#x0066cc} else {#xf5f5f7} draw_bg.color_hover: if state.config.preferences.route == option.id {#x0066cc} else {#xe8e8ed} draw_bg.color_down: if state.config.preferences.route == option.id {#x0055aa} else {#xdedee5} draw_text.color_hover: if state.config.preferences.route == option.id {#xffffff} else {#x0066cc} draw_text.color_down: if state.config.preferences.route == option.id {#xffffff} else {#x0066cc} draw_text.color: if state.config.preferences.route == option.id {#xffffff} else {#x0066cc} text: option.name on_click: || send("preferences",{mode: state.config.preferences.mode route: option.id})}
            }
        }
        View{width: Fill height: 28}
        SmallHeading{text: "固定通勤"}
        View{width: Fill height: 12}
        commute_setup := Secondary{text: "设置固定通勤" on_click: || {let c=state.config.commute;commuteDateMode=c.dateMode;arrivalText=if c.requiredArrival != "" {c.requiredArrival} else {"09:00"};commuteOrigin="";commuteDest="";for p in state.config.places {if p.type == "home" {commuteOrigin=p.id};if p.type == "work" {commuteDest=p.id}};choosingDays=false;go("commute")}}
        View{width: Fill height: 28}
        SmallHeading{text: "AI记忆"}
        View{width: Fill height: 12}
        ai_memory_box := RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 12 draw_bg.color: #xf5f5f7 draw_bg.border_radius: 10
            ai_memory_personal_title := SmallHeading{text: "个性化偏好"}
            ai_memory_personal := BodyText{text: state.aiMemory.personal}
            View{width: Fill height: 8}
            ai_memory_history_title := SmallHeading{text: "历史记忆"}
            ai_memory_text := BodyText{text: state.aiMemory.historical}
            ai_memory_status := Caption{text: state.aiMemory.status}
        }
        // Keep the empty loop: the native renderer requires a balanced final branch.
        for i in 0 {View{width: Fill height: 0}}
    } elif page == "commute" {
        Heading{text: "固定通勤"}
        View{width: Fill height: 24}
        SmallHeading{text: "家"}
        View{width: Fill height: 12}
        for p in state.config.places {if p.type == "home" {
            Secondary{text: p.name draw_bg.color: if commuteOrigin == p.id {#x0066cc} else {#xf5f5f7} draw_text.color: if commuteOrigin == p.id {#xffffff} else {#x0066cc} draw_bg.color_hover: if commuteOrigin == p.id {#x0066cc} else {#xe8e8ed} draw_bg.color_down: if commuteOrigin == p.id {#x0055aa} else {#xdedee5} draw_text.color_hover: if commuteOrigin == p.id {#xffffff} else {#x0066cc} draw_text.color_down: if commuteOrigin == p.id {#xffffff} else {#x0066cc} on_click: || {commuteOrigin=p.id;ui.board.render()}}
        }}
        if commuteOrigin == "" {Caption{text: "请先在常用地点设置家"}}
        View{width: Fill height: 20}
        SmallHeading{text: "公司"}
        View{width: Fill height: 12}
        for p in state.config.places {if p.type == "work" {
            Secondary{text: p.name draw_bg.color: if commuteDest == p.id {#x0066cc} else {#xf5f5f7} draw_text.color: if commuteDest == p.id {#xffffff} else {#x0066cc} draw_bg.color_hover: if commuteDest == p.id {#x0066cc} else {#xe8e8ed} draw_bg.color_down: if commuteDest == p.id {#x0055aa} else {#xdedee5} draw_text.color_hover: if commuteDest == p.id {#xffffff} else {#x0066cc} draw_text.color_down: if commuteDest == p.id {#xffffff} else {#x0066cc} on_click: || {commuteDest=p.id;ui.board.render()}}
        }}
        if commuteDest == "" {Caption{text: "请先在常用地点设置公司"}}
        View{width: Fill height: 24}
        View{width: Fill height: Fit flow: Right spacing: 16
            View{width: Fill height: Fit flow: Down spacing: 12
                SmallHeading{text: "上班时间"}
                commute_arrival_entry := Entry{text: arrivalText empty_text: "09:00" on_change: |t| {arrivalText=t;dirty=true}}
            }
            View{width: Fill height: Fit flow: Down spacing: 12
                SmallHeading{text: "下班时间"}
                commute_return_entry := Entry{text: returnText empty_text: "18:00" on_change: |t| {returnText=t;dirty=true}}
            }
        }
        View{width: Fill height: 24}
        SmallHeading{text: "通勤日期"}
        View{width: Fill height: 12}
        View{width: Fill height: Fit flow: Right spacing: 12
            commute_official := Secondary{text: "官方日期" draw_bg.color: if commuteDateMode == "official" {#x0066cc} else {#xf5f5f7} draw_text.color: if commuteDateMode == "official" {#xffffff} else {#x0066cc} draw_bg.color_hover: if commuteDateMode == "official" {#x0066cc} else {#xe8e8ed} draw_bg.color_down: if commuteDateMode == "official" {#x0055aa} else {#xdedee5} draw_text.color_hover: if commuteDateMode == "official" {#xffffff} else {#x0066cc} draw_text.color_down: if commuteDateMode == "official" {#xffffff} else {#x0066cc} on_click: || {commuteDateMode="official";choosingDays=false;dirty=false;ui.board.render()}}
            commute_custom := Secondary{text: "自定义" draw_bg.color: if commuteDateMode == "custom" {#x0066cc} else {#xf5f5f7} draw_text.color: if commuteDateMode == "custom" {#xffffff} else {#x0066cc} draw_bg.color_hover: if commuteDateMode == "custom" {#x0066cc} else {#xe8e8ed} draw_bg.color_down: if commuteDateMode == "custom" {#x0055aa} else {#xdedee5} draw_text.color_hover: if commuteDateMode == "custom" {#xffffff} else {#x0066cc} draw_text.color_down: if commuteDateMode == "custom" {#xffffff} else {#x0066cc} on_click: || {commuteDateMode="custom";choosingDays=true;dirty=false;ui.board.render()}}
        }
        if commuteDateMode == "official" {View{height: 12};Caption{text: "2026 年官方工作日，包含调休上班日。"}}
        if choosingDays {
            View{width: Fill height: 16}
            RoundedView{width: Fill height: Fit flow: Down padding: 12 spacing: 12 draw_bg.color: #xf5f5f7 draw_bg.border_radius: 10
                BodyText{text: "选择每周通勤日期"}
                View{width: Fill height: Fit flow: Right spacing: 4
                    for i in 7 {Secondary{width: Fill text: ""+(i+1) draw_bg.color: if commuteDays[i] {#x0066cc} else {#xffffff} draw_text.color: if commuteDays[i] {#xffffff} else {#x0066cc} draw_bg.color_hover: if commuteDays[i] {#x0066cc} else {#xe8e8ed} draw_bg.color_down: if commuteDays[i] {#x0055aa} else {#xdedee5} draw_text.color_hover: if commuteDays[i] {#xffffff} else {#x0066cc} draw_text.color_down: if commuteDays[i] {#xffffff} else {#x0066cc} on_click: || {commuteDays[i]=!commuteDays[i];dirty=false;ui.board.render()}}}
                }
                Secondary{text: "完成" on_click: || {choosingDays=false;ui.board.render()}}
            }
        }
        View{width: Fill height: 24}
        commute_save := Action{text: "保存固定通勤" on_click: || saveHabits()}
        View{width: Fill height: 16}
        commute_notice := Caption{text: notice}
        for i in 0 {View{width: Fill height: 0}}
    }
    status := Caption{text: if page == "clear_history" {notice} else {""}}
    }
    if page == "routes" {
        Rule{}
        View{width: Fill height: Fit flow: Down padding: Inset{left: 24 right: 24 top: 16 bottom: 24} spacing: 12
            Action{text: "开始导航" on_click: || {if pending == "" {send("start",{});startPending=pending}}}
        }
    }
}
}}
}
