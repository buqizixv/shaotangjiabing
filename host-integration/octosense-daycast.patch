+            reply.finish(match result {
+                Ok(value) => ToolOutcome::Ok(value),
+                Err(error) => ToolOutcome::error("daycast_schedule", error),
+            });
+        } else {
+            self.services.execute(call, reply);
+        }
+    }
+
+    fn cancel(&self, call_id: &str) {
+        self.services.cancel(call_id);
+    }
